# Copy this file to .env and fill it in.

# Password your iPhone uses to talk to Jarvis. Make it long and random (12+ characters).
JARVIS_TOKEN=change-me-to-a-long-random-password

# How Jarvis addresses you, and your city (for weather etc.)
JARVIS_USER_NAME=sir
JARVIS_CITY=

# ---- Brain ----
# ollama = free, runs on your PC (default).  claude = smarter, needs an Anthropic API key.
JARVIS_BRAIN=ollama

# Ollama model. qwen2.5:7b needs ~8 GB free RAM. Weak PC? use qwen2.5:3b. Strong GPU? try qwen2.5:14b.
JARVIS_OLLAMA_MODEL=qwen2.5:7b
# Optional: a model that can see the screen, e.g. gemma3:4b (run: ollama pull gemma3:4b). Leave empty to turn off.
JARVIS_VISION_MODEL=

# Only for JARVIS_BRAIN=claude (also run: pip install anthropic)
ANTHROPIC_API_KEY=
JARVIS_EFFORT=low

# ---- Other ----
# Set to 0 to turn off the PC microphone/voice (phone + typing still work)
JARVIS_VOICE=1
JARVIS_WAKE_WORD=jarvis
JARVIS_PORT=8765
